FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .

ARG VITE_AUTH_URL
ENV VITE_AUTH_URL=$VITE_AUTH_URL
ARG VITE_PATIENT_URL
ENV VITE_PATIENT_URL=$VITE_PATIENT_URL
ARG VITE_APPOINTMENT_URL
ENV VITE_APPOINTMENT_URL=$VITE_APPOINTMENT_URL
ARG VITE_BILLING_URL
ENV VITE_BILLING_URL=$VITE_BILLING_URL
ARG VITE_ANALYTICS_URL
ENV VITE_ANALYTICS_URL=$VITE_ANALYTICS_URL
ARG VITE_DOCTOR_URL
ENV VITE_DOCTOR_URL=$VITE_DOCTOR_URL
ARG VITE_ADMIN_URL
ENV VITE_ADMIN_URL=$VITE_ADMIN_URL
ARG VITE_REVIEW_URL
ENV VITE_REVIEW_URL=$VITE_REVIEW_URL
ARG VITE_NOTIFICATION_URL
ENV VITE_NOTIFICATION_URL=$VITE_NOTIFICATION_URL
ARG VITE_AI_URL
ENV VITE_AI_URL=$VITE_AI_URL

RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]